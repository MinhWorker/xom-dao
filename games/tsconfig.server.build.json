{
  "$comment": "Compiles a new platform Game server entry (server/index.ts, and manifest.ts it imports) to dist/server/ and dist/manifest.js.",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "${configDir}",
    "outDir": "${configDir}/dist",
    "declaration": true,
    "declarationMap": true,
    "incremental": true
  },
  "files": ["${configDir}/server/index.ts"]
}
