{
  "name": "@xomdao/hub-assets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Makes the images a Game shows in the Hub from its hub/key-art.png and fails the build when they are missing or wrong.",
  "bin": {
