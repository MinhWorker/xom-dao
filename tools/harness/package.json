{
  "name": "@xomdao/harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Harness: a local stand-in for the Hub that runs one Game against a real server, with a CLI for agents and a debug page.",
  "bin": {
    "harness": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --incremental false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@xomdao/bridge": "*",
    "@xomdao/shared": "*",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.1",
    "vitest": "^5.0.5"
  }
}
