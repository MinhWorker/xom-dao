{
  "name": "@xomdao/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Everything a Game server may use: the Turn-based Game class, the Game manifest, rng helpers and testGame.",
  "exports": {
    ".": {
      "xomdao-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./legacy": {
      "xomdao-source": "./src/legacy/index.ts",
      "types": "./dist/legacy/index.d.ts",
      "default": "./dist/legacy/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --incremental false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
