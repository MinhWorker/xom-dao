{
  "name": "@xomdao/bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Bridge between the Hub and an embedded Game: its zod schemas, the Hub's GameHost and the Game's GameBridge.",
  "exports": {
    ".": {
      "xomdao-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --incremental false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "vitest": "^5.0.5"
  }
}
