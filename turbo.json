{
  "$schema": "https://turborepo.dev/schema.json",
  "envMode": "loose",
  "globalDependencies": [
    "tsconfig.base.json",
    "games/tsconfig.base.json",
    "games/tsconfig.build.json",
    "games/tsconfig.server.build.json",
    "scripts/libs.mjs",
    "scripts/game-version.mjs"
  ],
  "remoteCache": { "enabled": true },
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "env": ["TEST_DATABASE_URL"] },
    "@xomdao/hub#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/package.json"]
    }
  }
}
