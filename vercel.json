{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "XOMDAO_SERVER_URL=https://play-some-cards-server.onrender.com npx turbo run build --filter=@xomdao/hub",
  "outputDirectory": "apps/hub/dist",
  "framework": null,
  "rewrites": [{ "source": "/((?!games/|assets/).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/((?!assets/|games/).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
