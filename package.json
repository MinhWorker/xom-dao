{
  "name": "xom-dao",
  "version": "0.28.0",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "npm@10.9.8",
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/*",
    "tools/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/libs.mjs --generate",
    "dev": "node scripts/libs.mjs && concurrently -k -n shared,server,hub -c magenta,blue,green \"npm run dev -w @xomdao/shared\" \"npm run dev -w @xomdao/server\" \"npm run dev -w @xomdao/hub\"",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && turbo run typecheck test",
    "smoke": "node scripts/smoke.mjs",
    "smoke:web": "node scripts/smoke-web.mjs",
    "smoke:hub": "node scripts/smoke-hub.mjs",
    "e2e": "node scripts/e2e.mjs",
    "harness": "node scripts/harness.mjs",
    "wt": "node scripts/worktree.mjs",
    "assets": "node scripts/assets.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.65.1",
    "sharp": "^0.35.5",
    "turbo": "^2.11.13",
    "typescript": "~6.0.2",
    "ws": "^8.22.0"
  }
}
